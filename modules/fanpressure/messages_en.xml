    <message id="fanpressure_story_message_trait_star_performance">{player} demonstrates the special ability {trait} at {team}. {reason}. Fans and the board view this development positively.</message>
    <message id="fanpressure_story_title_trait_big_moment">{player} shapes the match with {trait}</message>
    <message id="fanpressure_story_message_trait_big_moment">{player} produces a special moment for {team} as {trait}. {reason}. The media highlight this special ability.</message>

