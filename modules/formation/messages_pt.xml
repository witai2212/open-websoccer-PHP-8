	<message id="formation_tacticalstyle_title">Identidade tática</message>
	<message id="formation_tacticalstyle_select">Estilo de jogo</message>
	<message id="formation_tacticalstyle_fit">Adequação</message>
	<message id="formation_tacticalstyle_effect_help">A identidade tática tem apenas um pequeno efeito nos jogos e recompensa sobretudo uma boa adequação entre estilo, plantel, treino e equipa técnica.</message>
	<message id="tacticalstyle_balanced">Equilibrado</message>
	<message id="tacticalstyle_balanced_help">Estilo neutro sem especialização rígida. Força base, técnica, condição física, passe, desarme e frescura contam de forma equilibrada.</message>
	<message id="tacticalstyle_defensive">Defensivo</message>
	<message id="tacticalstyle_defensive_help">Desarme, jogo de cabeça, condição física e jogadores influentes reforçam um estilo defensivo compacto.</message>
	<message id="tacticalstyle_possession">Posse de bola</message>
	<message id="tacticalstyle_possession_help">Passe, técnica, criatividade e criatividade individual elevados favorecem este estilo.</message>
	<message id="tacticalstyle_counterattack">Contra-ataque</message>
	<message id="tacticalstyle_counterattack_help">Velocidade, finalização, passe e frescura adequam-se especialmente bem a transições rápidas.</message>
	<message id="tacticalstyle_pressing">Pressão</message>
	<message id="tacticalstyle_pressing_help">Condição física, velocidade, desarme e mentalidade tornam a pressão mais consistente.</message>
	<message id="tacticalstyle_defensive_block">Bloco defensivo</message>
	<message id="tacticalstyle_defensive_block_help">Desarme, jogo de cabeça, condição física e influência reforçam um bloco compacto.</message>
	<message id="tacticalstyle_wing_play">Jogo pelas alas</message>
	<message id="tacticalstyle_wing_play_help">Velocidade, passe, criatividade individual e criatividade favorecem ataques pelas alas.</message>
	<message id="tacticalstyle_set_pieces">Bolas paradas</message>
	<message id="tacticalstyle_set_pieces_help">Livres, jogo de cabeça, finalização e influência aumentam a força nas bolas paradas.</message>
	<message id="tacticalstyle_youth_focused">Foco na formação</message>
	<message id="tacticalstyle_youth_focused_help">Potencial elevado, jogadores jovens, frescura e líderes adequam-se a este estilo.</message>
	<message id="tacticalstyle_physical">Físico</message>
	<message id="tacticalstyle_physical_help">Condição física, jogo de cabeça, desarme e força base são decisivos neste estilo.</message>
	<message id="tacticalstyle_fit_good">O teu plantel adequa-se muito bem a este estilo.</message>
	<message id="tacticalstyle_fit_neutral">O teu plantel adequa-se razoavelmente bem a este estilo.</message>
	<message id="tacticalstyle_fit_bad">Atualmente este estilo adequa-se apenas parcialmente ao teu plantel.</message>
