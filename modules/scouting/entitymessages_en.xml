    <!-- Existing scout entity -->
    <message id="entity_scout">Scout</message>
    <message id="entity_scout_name">Name</message>
    <message id="entity_scout_name_help">Name of the scout displayed to users in the game.</message>
    <message id="entity_scout_nation">Nation</message>
    <message id="entity_scout_nation_help">Scout’s country of origin. May later be used for regional scouting advantages.</message>
    <message id="entity_scout_speciality">Speciality</message>
    <message id="entity_scout_speciality_help">Position for which this scout should provide particularly good assessments.</message>
    <message id="entity_scout_expertise">Internal expertise</message>
    <message id="entity_scout_expertise_help">Internal value from 1 to 100. This value is not shown directly to managers, but affects the quality and accuracy of scout reports.</message>
    <message id="entity_scout_fee">Cost per matchday</message>
    <message id="entity_scout_fee_help">Amount charged to the club per relevant matchday while the scout is employed.</message>
    <message id="entity_scout_team_id">Club</message>
    <message id="entity_scout_team_id_help">Club currently employing the scout. 0 or blank means the scout is available.</message>
    <message id="entity_scout_team_matches">Remaining matches</message>
    <message id="entity_scout_team_matches_help">Number of matches for which the scout will remain employed by the club.</message>

    <!-- Scouting department level -->
    <message id="entity_scoutingdepartmentlevel">Scouting department level</message>
    <message id="entity_scoutingdepartmentlevel_level">Level</message>
    <message id="entity_scoutingdepartmentlevel_level_help">Internal scouting department level. Higher levels enable better and more extensive scouting activities.</message>
    <message id="entity_scoutingdepartmentlevel_name">Name</message>
    <message id="entity_scoutingdepartmentlevel_name_help">Display name of the upgrade level, e.g. Small Scouting Department or International Scouting Network.</message>
    <message id="entity_scoutingdepartmentlevel_build_cost">Construction cost</message>
    <message id="entity_scoutingdepartmentlevel_build_cost_help">One-off cost to build or upgrade to this level.</message>
    <message id="entity_scoutingdepartmentlevel_maintenance_fee">Maintenance per matchday</message>
    <message id="entity_scoutingdepartmentlevel_maintenance_fee_help">Ongoing cost per matchday for this scouting department level.</message>
    <message id="entity_scoutingdepartmentlevel_max_scouts">Max. scouts</message>
    <message id="entity_scoutingdepartmentlevel_max_scouts_help">Maximum number of scouts a club may employ simultaneously with this department level.</message>
    <message id="entity_scoutingdepartmentlevel_max_camps">Max. camps</message>
    <message id="entity_scoutingdepartmentlevel_max_camps_help">Maximum number of active scouting camps. Very high values allow wealthy clubs to operate a correspondingly large number of camps.</message>
    <message id="entity_scoutingdepartmentlevel_status">Active</message>
    <message id="entity_scoutingdepartmentlevel_status_help">Only active levels can be used by clubs.</message>

    <!-- Scouting camp location -->
    <message id="entity_scoutingcamplocation">Scouting camp location</message>
    <message id="entity_scoutingcamplocation_name">Name</message>
    <message id="entity_scoutingcamplocation_name_help">Name of the location or region, e.g. Germany, Brazil or West Africa.</message>
    <message id="entity_scoutingcamplocation_country">Country</message>
    <message id="entity_scoutingcamplocation_country_help">Optional country of the location. Leave blank if it is a region or continent.</message>
    <message id="entity_scoutingcamplocation_continent">Continent</message>
    <message id="entity_scoutingcamplocation_continent_help">Continent or region of the location. Possible values include EU, AF, AS, NA, SA or OC.</message>
    <message id="entity_scoutingcamplocation_base_fee">Base cost per matchday</message>
    <message id="entity_scoutingcamplocation_base_fee_help">Base amount charged per matchday for an active camp at this location.</message>
    <message id="entity_scoutingcamplocation_travel_cost_modifier">Travel cost modifier</message>
    <message id="entity_scoutingcamplocation_travel_cost_modifier_help">Percentage surcharge or discount for this location. Positive values make the camp more expensive; negative values make it cheaper.</message>
    <message id="entity_scoutingcamplocation_quality_modifier">Quality modifier</message>
    <message id="entity_scoutingcamplocation_quality_modifier_help">Affects the average quality of players found at this location.</message>
    <message id="entity_scoutingcamplocation_talent_modifier">Talent modifier</message>
    <message id="entity_scoutingcamplocation_talent_modifier_help">Affects the chance of finding players with higher talent or better potential.</message>
    <message id="entity_scoutingcamplocation_min_department_level">Minimum scouting department level</message>
    <message id="entity_scoutingcamplocation_min_department_level_help">Minimum level a club requires to open a camp at this location.</message>
    <message id="entity_scoutingcamplocation_status">Active</message>
    <message id="entity_scoutingcamplocation_status_help">Only active locations can be selected by managers.</message>

