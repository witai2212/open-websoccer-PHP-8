<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE messages SYSTEM "../messages.dtd">
<messages>
    <message id="settings_label_team_chemistry_enabled">Enable team chemistry</message>
    <message id="settings_label_team_chemistry_enabled_help">Enables the team chemistry value, the chemistry page and the small simulation effects.</message>
    <message id="settings_label_team_chemistry_max_match_effect">Maximum simulation effect of team chemistry</message>
    <message id="settings_label_team_chemistry_max_match_effect_help">Default: 3. The value is used as a small percentage/point effect on passing, morale and stability.</message>
    <message id="settings_label_team_chemistry_recent_transfer_days">Period for new transfers</message>
    <message id="settings_label_team_chemistry_recent_transfer_days_help">Transfers within this period slightly reduce chemistry so that too many new players do not immediately work perfectly together.</message>
    <message id="settings_label_team_chemistry_formation_history_count">Number of formations for familiarity</message>
    <message id="settings_label_team_chemistry_formation_history_count_help">This many recent lineups are checked to assess formation familiarity.</message>
    <message id="teamchemistry_factor_tactical_style">Tactical DNA</message>
    <message id="teamchemistry_source_tactical_style">Tactical DNA</message>
    <message id="teamchemistry_score">Chemistry</message>
    <message id="teamchemistry_match_effect">Match effect</message>
</messages>