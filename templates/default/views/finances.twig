{# CM23 Task 1004 + Finance Assets | 2026-08-25 | Revision 4 #}
{% extends "base.twig" %}

{% import "macros/messagebox.twig" as messagebox %}
{% import "macros/paginator.twig" as pagination %}

{% block page_title %}
{{ i18n.getMessage("finances_navlabel") }}
{% endblock %}

{% block page_content %}

<ul class="nav nav-tabs" id="financesTab">
  <li class="active"><a href="#grouped_values" data-toggle="tab">{{ i18n.getMessage("finance_overview") }}</a></li>
  
  <li><a href="#account_statement" data-toggle="tab" class="ajaxLink"
			data-ajaxtarget="account_statementlist" data-ajaxblock="account_statement">{{ i18n.getMessage("finance_account_statement") }}</a></li>

  <li><a href="#finance_development" data-toggle="tab">{{ i18n.getMessage("finance_cash_development") }}</a></li>
  <li><a href="#private_account" data-toggle="tab">{{ i18n.getMessage("private_account_tab") }}</a></li>
  <li><a href="#financialforecast" data-toggle="tab">{{ i18n.getMessage("financialforecast_navlabel") }}</a></li>
</ul>



{% if cash_chart_values|length > 0 or forecast_rows|length > 0 %}
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endif %}

<div class="tab-content">
	<h3>{{ i18n.getMessage("entity_club_finanz_budget") }}: {{ budget|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</h3>
	<hr>
	<div class="tab-pane active" id="grouped_values">

		{% set penalty = transfer_penalty_summary %}
		<div class="well">
			<h4><i class="icon-warning-sign"></i> {{ i18n.getMessage("finance_transfer_penalties_title") }}</h4>
			<div class="row-fluid">
				<div class="span3">
					<strong>{{ i18n.getMessage("finance_transfer_penalties_season") }}</strong><br>
					{% if penalty.season_total > 0 %}
						<span class="text-error">{{ penalty.season_total|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span>
					{% else %}
						{{ penalty.season_total|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
					{% endif %}
				</div>
				<div class="span3">
					<strong>{{ i18n.getMessage("finance_transfer_penalties_last") }}</strong><br>
					{% if penalty.last_date > 0 %}
						{{ env.getFormattedDate(penalty.last_date) }} / <span class="text-error">{{ penalty.last_amount|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span>
					{% else %}
						{{ i18n.getMessage("finance_transfer_penalties_none") }}
					{% endif %}
				</div>
				<div class="span3">
					<strong>{{ i18n.getMessage("finance_transfer_penalties_distribution") }}</strong><br>
					{% if penalty.last_distribution_date > 0 %}
						{{ env.getFormattedDate(penalty.last_distribution_date) }} / {{ penalty.last_distribution_amount|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
					{% else %}
						{{ i18n.getMessage("finance_transfer_penalties_distribution_none") }}
					{% endif %}
				</div>
				<div class="span3">
					<strong>{{ i18n.getMessage("finance_transfer_penalties_pot") }}</strong><br>
					{{ penalty.penalty_pot|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
				</div>
			</div>
			<p class="muted" style="margin-top: 10px; margin-bottom: 0;">
				{{ i18n.getMessage("finance_transfer_penalties_hint") }}
			</p>
		</div>


		{% if stockmarket_info is defined %}
			<div class="well">
				<h4><i class="icon-signal"></i> {{ i18n.getMessage("stockmarket_ipo_title") }}</h4>
				{% if stockmarket_info.is_listed %}
					<p class="text-success">
						<i class="icon-ok"></i> {{ i18n.getMessage("stockmarket_ipo_already_listed") }}
					</p>
					<p>
						<a class="btn btn-mini" href="?page=stockmarket"><i class="icon-signal"></i> {{ i18n.getMessage("stockmarket_navlabel") }}</a>
					</p>
				{% else %}
					<div class="row-fluid">
						<div class="span3">
							<strong>{{ i18n.getMessage("stockmarket_ipo_club_value") }}</strong><br>
							{{ stockmarket_info.club_value|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
						</div>
						<div class="span3">
							<strong>{{ i18n.getMessage("stockmarket_ipo_income") }}</strong><br>
							{{ stockmarket_info.ipo_income|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
						</div>
						<div class="span3">
							<strong>{{ i18n.getMessage("stockmarket_ipo_initial_price") }}</strong><br>
							{{ stockmarket_info.initial_price|number_format(2, ',', ' ') }} {{ env.getConfig("game_currency") }}
						</div>
						<div class="span3">
							<strong>{{ i18n.getMessage("stockmarket_ipo_shares") }}</strong><br>
							{{ stockmarket_info.shares|number_format(0, ',', ' ') }}
						</div>
					</div>

					<table class="table table-condensed" style="margin-top: 10px;">
						<thead>
							<tr>
								<th>{{ i18n.getMessage("stockmarket_ipo_requirement") }}</th>
								<th>{{ i18n.getMessage("stockmarket_ipo_current") }}</th>
								<th>{{ i18n.getMessage("stockmarket_ipo_required") }}</th>
								<th>&nbsp;</th>
							</tr>
						</thead>
						<tbody>
						{% for requirement in stockmarket_info.requirements %}
							<tr>
								<td>{{ i18n.getMessage(requirement.label_key) }}</td>
								<td>{{ requirement.actual|number_format(0, ',', ' ') }}</td>
								<td>{{ requirement.required|number_format(0, ',', ' ') }}</td>
								<td>
									{% if requirement.met %}
										<span class="label label-success">{{ i18n.getMessage("stockmarket_ipo_req_met") }}</span>
									{% else %}
										<span class="label label-important">{{ i18n.getMessage("stockmarket_ipo_req_missing") }}</span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
						</tbody>
					</table>

					{% if stockmarket_info.criteria_met %}
						<p>
							<a class="btn btn-primary" href="?page=stockmarket&id={{ team_id }}&action=put_team_on_stockmarket">
								<i class="icon-thumbs-up icon-white"></i> {{ i18n.getMessage("put_team_on_stockmarket") }}
							</a>
						</p>
					{% else %}
						<p class="muted" style="margin-bottom: 0;">{{ i18n.getMessage("stockmarket_ipo_not_available_hint") }}</p>
					{% endif %}
				{% endif %}
			</div>
		{% endif %}

		{% if finance_groups|length > 0 %}
			<div class="well" style="padding: 10px 15px;">
				<table class="table table-condensed" style="margin-bottom: 0; table-layout: fixed;">
					<thead>
						<tr>
							<th style="width: 46%;">{{ i18n.getMessage("finance_group_total") }}</th>
							<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_revenues") }}</th>
							<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_expenses") }}</th>
							<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_balance") }}</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><strong>{{ i18n.getMessage("entity_club_finanz_bilanz_summe") }}</strong></td>
							<td class="text-right">{{ total_revenues|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</td>
							<td class="text-right"><span class="text-error">{{ total_expenses|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span></td>
							<td class="text-right">
								{% if total_expenses + total_revenues >= 0 %}
									<strong class="text-success">+{{ (total_expenses + total_revenues)|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</strong>
								{% else %}
									<strong class="text-error">{{ (total_expenses + total_revenues)|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</strong>
								{% endif %}
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<table class="table table-condensed" style="margin-bottom: 5px; table-layout: fixed;">
				<thead>
					<tr>
						<th style="width: 46%;">{{ i18n.getMessage("finance_group_category") }}</th>
						<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_revenues") }}</th>
						<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_expenses") }}</th>
						<th class="text-right" style="width: 18%;">{{ i18n.getMessage("finance_group_balance") }}</th>
					</tr>
				</thead>
			</table>

			<div class="accordion" id="financeGroups">
			{% for group in finance_groups %}
				<div class="accordion-group" style="margin-bottom: 8px;">
					<div class="accordion-heading">
						<table class="table table-condensed" style="margin-bottom: 0; table-layout: fixed;">
							<tbody>
								<tr>
									<td style="width: 46%;">
										<a class="accordion-toggle" style="display: inline; padding: 0;" data-toggle="collapse" href="#financeGroup_{{ group.key }}">
											<i class="{{ group.icon }}"></i>
											<strong>{{ i18n.getMessage(group.label_key) }}</strong>
										</a>
										{% if group.is_high_loss %}
											<span class="label label-important">{{ i18n.getMessage("finance_group_high_loss") }}</span>
										{% endif %}
									</td>
									<td class="text-right" style="width: 18%;">
										{% if group.revenues > 0 %}+{{ group.revenues|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}{% else %}&ndash;{% endif %}
									</td>
									<td class="text-right" style="width: 18%;">
										{% if group.expenses < 0 %}<span class="text-error">{{ group.expenses|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span>{% else %}&ndash;{% endif %}
									</td>
									<td class="text-right" style="width: 18%;">
										{% if group.balance >= 0 %}
											<strong class="text-success">+{{ group.balance|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</strong>
										{% else %}
											<strong class="text-error">{{ group.balance|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</strong>
										{% endif %}
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					<div id="financeGroup_{{ group.key }}" class="accordion-body collapse{% if group.is_high_loss %} in{% endif %}">
						<div class="accordion-inner" style="padding: 0;">
							<table class="table table-striped table-condensed" style="margin-bottom: 0;">
								<tbody>
								{% for entry in group.entries %}
									<tr>
										<td>
											{% if i18n.hasMessage(entry.verwendung) %}
												{{ i18n.getMessage(entry.verwendung) }}
											{% else %}
												{{ entry.verwendung }}
											{% endif %}
										</td>
										<td class="text-right" style="width: 30%;">
											{% if entry.betrag >= 0 %}
												<span class="text-success">+{{ entry.betrag|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span>
											{% else %}
												<span class="text-error">{{ entry.betrag|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</span>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			{% endfor %}
			</div>
		{% endif %}
		
	</div>
	
	<div class="tab-pane" id="account_statement">
		<div id="account_statementlist">
			{% include "blocks/account_statement_content.twig" %}
		</div>
	</div>

	<div class="tab-pane" id="finance_development">

	<h4>{{ i18n.getMessage("finance_cash_chart_title") }}</h4>

	<div class="row-fluid">
		<div class="span4">
			<div class="well">
				<strong>{{ i18n.getMessage("finance_asset_cash_current") }}</strong><br>
				{{ budget|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
			</div>
		</div>
		<div class="span4">
			<div class="well">
				<strong>{{ i18n.getMessage("finance_asset_portfolio_current") }}</strong><br>
				{{ current_portfolio_value|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
			</div>
		</div>
		<div class="span4">
			<div class="well">
				<strong>{{ i18n.getMessage("finance_asset_total_current") }}</strong><br>
				{{ current_total_assets|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
			</div>
		</div>
	</div>

	{% if portfolio_tracking_start > cash_chart_season_start %}
		<div class="alert alert-info">
			<i class="icon-info-sign"></i>
			{{ i18n.getMessage("finance_asset_tracking_hint") }}
			{{ env.getFormattedDate(portfolio_tracking_start) }}
		</div>
	{% endif %}

	{% if cash_chart_values|length > 0 %}
		<canvas id="financeCashLineChart" width="900" height="400"></canvas>

		<script>
		const financeCashCtx = document.getElementById('financeCashLineChart').getContext('2d');

		new Chart(financeCashCtx, {
			type: 'line',
			data: {
				labels: [
					{% for label in cash_chart_labels %}
						{% if not loop.first %}, {% endif %}'{{ label }}'
					{% endfor %}
				],
				datasets: [
					{
						label: '{{ i18n.getMessage("finance_asset_cash_curve") }}',
						data: [
							{% for value in cash_chart_values %}
								{% if not loop.first %}, {% endif %}{{ value }}
							{% endfor %}
						],
						fill: false,
						borderColor: 'rgba(75, 192, 192, 1)',
						tension: 0.1
					},
					{
						label: '{{ i18n.getMessage("finance_asset_portfolio_curve") }}',
						data: [
							{% for value in portfolio_chart_values %}
								{% if not loop.first %}, {% endif %}{% if value is null %}null{% else %}{{ value }}{% endif %}
							{% endfor %}
						],
						fill: false,
						borderColor: 'rgba(255, 159, 64, 1)',
						tension: 0.1,
						spanGaps: false
					},
					{
						label: '{{ i18n.getMessage("finance_asset_total_curve") }}',
						data: [
							{% for value in total_asset_chart_values %}
								{% if not loop.first %}, {% endif %}{% if value is null %}null{% else %}{{ value }}{% endif %}
							{% endfor %}
						],
						fill: false,
						borderColor: 'rgba(54, 162, 235, 1)',
						tension: 0.1,
						spanGaps: false
					}
				]
			},
			options: {
				interaction: {
					mode: 'index',
					intersect: false
				},
				scales: {
					y: {
						beginAtZero: false
					}
				}
			}
		});
		</script>
	{% else %}
		<p>
			<i class="icon-info-sign"></i>
			{{ i18n.getMessage("finance_cash_chart_no_data") }}
		</p>
	{% endif %}

</div>

	<div class="tab-pane" id="private_account">
		<h4>{{ i18n.getMessage("private_account_title") }}</h4>
		<p>{{ i18n.getMessage("private_account_intro") }}</p>

		<div class="row-fluid">
			<div class="span3">
				<div class="well">
					<strong>{{ i18n.getMessage("private_account_balance") }}</strong><br>
					{{ private_account.private_balance|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
				</div>
			</div>
			<div class="span3">
				<div class="well">
					<strong>{{ i18n.getMessage("private_account_club_balance") }}</strong><br>
					{{ private_account.club_balance|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
				</div>
			</div>
			<div class="span3">
				<div class="well">
					<strong>{{ i18n.getMessage("private_account_min_reserve") }}</strong><br>
					{{ private_account.minimum_club_reserve|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
				</div>
			</div>
			<div class="span3">
				<div class="well">
					<strong>{{ i18n.getMessage("private_account_max_withdrawal") }}</strong><br>
					{{ private_account.max_withdrawal|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}
				</div>
			</div>
		</div>

		{% if not private_account.has_shady_advisor %}
			<div class="alert alert-warning">
				<i class="icon-warning-sign"></i>
				{{ i18n.getMessage("private_account_advisor_required") }}
			</div>
		{% else %}
			<div class="alert alert-success">
				<i class="icon-ok"></i>
				{{ i18n.getMessage("private_account_advisor_active") }}
			</div>

			<div class="row-fluid">
				<div class="span6">
					<div class="well">
						<h5>{{ i18n.getMessage("private_account_withdraw_title") }}</h5>
						{% if private_account.max_withdrawal > 0 %}
							<form method="post" action="{{ env.getInternalUrl("finance") }}#private_account">
								<label for="private_account_withdraw_amount">{{ i18n.getMessage("private_account_amount") }}</label>
								<input id="private_account_withdraw_amount" type="number" name="amount" min="1" max="{{ private_account.max_withdrawal }}" step="1" required>
								<input type="hidden" name="direction" value="club_to_private">
								<input type="hidden" name="action" value="private_account_transfer">
								<div class="form-actions">
									<button type="submit" class="btn btn-primary">{{ i18n.getMessage("private_account_withdraw_button") }}</button>
								</div>
							</form>
						{% else %}
							<p class="muted">{{ i18n.getMessage("private_account_no_withdrawal") }}</p>
						{% endif %}
					</div>
				</div>

				<div class="span6">
					<div class="well">
						<h5>{{ i18n.getMessage("private_account_deposit_title") }}</h5>
						{% if private_account.max_deposit > 0 %}
							<form method="post" action="{{ env.getInternalUrl("finance") }}#private_account">
								<label for="private_account_deposit_amount">{{ i18n.getMessage("private_account_amount") }}</label>
								<input id="private_account_deposit_amount" type="number" name="amount" min="1" max="{{ private_account.max_deposit }}" step="1" required>
								<input type="hidden" name="direction" value="private_to_club">
								<input type="hidden" name="action" value="private_account_transfer">
								<div class="form-actions">
									<button type="submit" class="btn btn-primary">{{ i18n.getMessage("private_account_deposit_button") }}</button>
								</div>
							</form>
						{% else %}
							<p class="muted">{{ i18n.getMessage("private_account_no_deposit") }}</p>
						{% endif %}
					</div>
				</div>
			</div>

			<p class="muted">
				<i class="icon-info-sign"></i>
				{{ i18n.getMessage("private_account_no_statement_hint") }}
			</p>
		{% endif %}
	</div>

	<div class="tab-pane" id="financialforecast">
		{% include "views/financialforecast.twig" %}
	</div>
	
</div>

<script>
(function($) {
	function activateFinanceTabFromHash() {
		var hash = window.location.hash;
		if (hash && $('#financesTab a[href="' + hash + '"]').length) {
			$('#financesTab a[href="' + hash + '"]').tab('show');
		}
	}

	$(function() {
		activateFinanceTabFromHash();

		$('#financesTab a[data-toggle="tab"]').on('shown', function(e) {
			var target = $(e.target).attr('href');
			if (!target || target.charAt(0) !== '#') {
				return;
			}

			if (window.history && window.history.replaceState) {
				window.history.replaceState(null, null, target);
			} else {
				window.location.hash = target;
			}
		});
	});
})(jQuery);
</script>
{% endblock %}