{# CM23 | 2026-09-01 | Revision 2 #}
{% import "macros/premium.twig" as premium %}
{% extends "base.twig" %}

{% block page_title %}
{{ i18n.getMessage("stadiumenvironment_navlabel") }}
{% endblock %}

{% block page_content %}

<h3>{{ i18n.getMessage("stadiumenvironment_effect_summary") }}</h3>
<div class="well">
	<div class="row-fluid">
		<div class="span3"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_income") }}</strong><br>{{ total_effect_income|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</div>
		<div class="span3"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_training") }}</strong><br>+{{ total_effect_training }}</div>
		<div class="span3"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_youthscouting") }}</strong><br>+{{ total_effect_youthscouting }}</div>
		<div class="span3"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_tickets") }}</strong><br>+{{ total_effect_tickets }} %</div>
	</div>
	<hr>
	<div class="row-fluid">
		<div class="span4"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_fanpopularity") }}</strong><br>+{{ total_effect_fanpopularity }}</div>
		<div class="span4"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_injury") }}</strong><br>-{{ total_effect_injury }} {{ i18n.getMessage("stadiumenvironment_effect_injury_unit") }}</div>
		<div class="span4"><strong>{{ i18n.getMessage("entity_stadiumbuilding_effect_merchandising") }}</strong><br>+{{ total_effect_merchandising }} %</div>
	</div>
	<p class="muted" style="margin-top: 10px; margin-bottom: 0;">{{ i18n.getMessage("stadiumenvironment_effect_summary_hint") }}</p>
</div>

<h3>{{ i18n.getMessage("stadiumenvironment_ground") }}</h3>
<p class="muted">{{ i18n.getMessage("stadiumenvironment_ground_hint") }}</p>
{% if existingBuildings|length == 0 %}
	<div class="well">{{ i18n.getMessage("stadiumenvironment_ground_empty") }}</div>
{% else %}
	<div class="well" style="background-color: #eef5e8; padding: 15px;">
		{% for building in existingBuildings %}
			<div style="display: inline-block; vertical-align: top; width: 145px; min-height: 165px; margin: 5px; padding: 10px; text-align: center; background: #fff; border: 1px solid #d5d5d5; border-radius: 4px;">
				<div style="height: 76px; line-height: 76px; margin-bottom: 6px;">
				{% if building.picture|length > 0 %}
					<img src="{{ env.getConfig("context_root") }}/uploads/stadiumbuilding/{{ building.picture }}" alt="{{ building.name }}" title="{{ building.description }}" style="max-width: 72px; max-height: 72px; vertical-align: middle;">
				{% else %}
					<i class="icon-home" title="{{ i18n.getMessage("stadiumenvironment_ground_placeholder") }}" style="font-size: 40px; vertical-align: middle;"></i>
				{% endif %}
				</div>
				<strong>{{ building.name }}</strong><br>
				{% if building.under_construction %}
					<span class="label label-warning"><i class="icon-wrench icon-white"></i> {{ i18n.getMessage("stadiumenvironment_status_construction") }}</span><br>
					<small>{{ env.getFormattedDatetime(building.construction_deadline, i18n) }}</small>
				{% elseif building.superseded %}
					<span class="label">{{ i18n.getMessage("stadiumenvironment_status_replaced") }}</span>
				{% else %}
					<span class="label label-success">{{ i18n.getMessage("stadiumenvironment_status_active") }}</span>
				{% endif %}
			</div>
		{% endfor %}
	</div>
{% endif %}

<h3>{{ i18n.getMessage("stadiumenvironment_existingbuildings") }}</h3>

{% if existingBuildings|length == 0 %}
	<div class="well">{{ i18n.getMessage("stadiumenvironment_existingbuildings_none") }}</div>
{% else %}
	<div style="overflow-x: auto;">
	<table class="table table-striped table-bordered table-condensed">
		<thead>
			<tr>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_picture") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_name") }}</th>
				<th>{{ i18n.getMessage("stadiumenvironment_status") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_required_building_id") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_costs") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_construction_time_days") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_income") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_training") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_youthscouting") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_tickets") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_fanpopularity") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_injury") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_merchandising") }}</th>
			</tr>
		</thead>
		<tbody>
		{% for building in existingBuildings %}
			<tr{% if building.under_construction %} class="warning"{% elseif building.superseded %} class="muted"{% endif %}>
				<td style="white-space: nowrap; text-align: center;">
					{% if building.picture|length > 0 %}
						<img src="{{ env.getConfig("context_root") }}/uploads/stadiumbuilding/{{ building.picture }}" alt="{{ building.name }}" style="max-width: 56px; max-height: 56px;">
					{% else %}-{% endif %}
				</td>
				<td><strong>{{ building.name }}</strong>{% if building.description %}<br><small>{{ building.description }}</small>{% endif %}</td>
				<td style="white-space: nowrap;">
					{% if building.under_construction %}
						<span class="label label-warning">{{ i18n.getMessage("stadiumenvironment_status_construction") }}</span><br><small>{{ env.getFormattedDatetime(building.construction_deadline, i18n) }}</small>
					{% elseif building.superseded %}
						<span class="label">{{ i18n.getMessage("stadiumenvironment_status_replaced") }}</span>
					{% else %}
						<span class="label label-success">{{ i18n.getMessage("stadiumenvironment_status_active") }}</span>
					{% endif %}
				</td>
				<td>{% if building.required_building_name %}{{ building.required_building_name }}{% else %}-{% endif %}</td>
				<td style="white-space: nowrap;">{{ building.costs|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}</td>
				<td>{{ building.construction_time_days }}</td>
				<td style="white-space: nowrap;">{% if building.effect_income != 0 %}{{ building.effect_income|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_training != 0 %}+{{ building.effect_training }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_youthscouting != 0 %}+{{ building.effect_youthscouting }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_tickets != 0 %}+{{ building.effect_tickets }} %{% else %}-{% endif %}</td>
				<td>{% if building.effect_fanpopularity != 0 %}+{{ building.effect_fanpopularity }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_injury != 0 %}-{{ building.effect_injury }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_merchandising != 0 %}+{{ building.effect_merchandising }} %{% else %}-{% endif %}</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
	</div>
{% endif %}

<h3>{{ i18n.getMessage("stadiumenvironment_availablebuildings") }}</h3>

{% if availableBuildings|length == 0 %}
	<div class="well">{{ i18n.getMessage("stadiumenvironment_availablebuildings_none") }}</div>
{% else %}
	<div style="overflow-x: auto;">
	<table class="table table-striped table-bordered table-condensed">
		<thead>
			<tr>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_picture") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_name") }}</th>
				<th>{{ i18n.getMessage("stadiumenvironment_status") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_required_building_id") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_costs") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_construction_time_days") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_income") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_training") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_youthscouting") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_tickets") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_fanpopularity") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_injury") }}</th>
				<th>{{ i18n.getMessage("entity_stadiumbuilding_effect_merchandising") }}</th>
				<th>{{ i18n.getMessage("stadiumenvironment_action") }}</th>
			</tr>
		</thead>
		<tbody>
		{% for building in availableBuildings %}
			<tr{% if not building.requirement_met %} class="muted"{% endif %}>
				<td style="white-space: nowrap; text-align: center;">
					{% if building.picture|length > 0 %}
						<img src="{{ env.getConfig("context_root") }}/uploads/stadiumbuilding/{{ building.picture }}" alt="{{ building.name }}" style="max-width: 56px; max-height: 56px;">
					{% else %}-{% endif %}
				</td>
				<td><strong>{{ building.name }}</strong>{% if building.description %}<br><small>{{ building.description }}</small>{% endif %}</td>
				<td>{% if building.requirement_met %}<span class="label label-success">{{ i18n.getMessage("stadiumenvironment_status_buildable") }}</span>{% else %}<span class="label">{{ i18n.getMessage("stadiumenvironment_status_locked") }}</span>{% endif %}</td>
				<td>{% if building.required_building_name %}{{ building.required_building_name }}{% else %}-{% endif %}</td>
				<td style="white-space: nowrap;">{{ building.costs|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}{% if building.premiumfee %}<br>{{ premium.premiumbadge(building.premiumfee) }}{% endif %}</td>
				<td>{{ building.construction_time_days }}</td>
				<td style="white-space: nowrap;">{% if building.effect_income != 0 %}{{ building.effect_income|number_format(0, ',', ' ') }} {{ env.getConfig("game_currency") }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_training != 0 %}+{{ building.effect_training }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_youthscouting != 0 %}+{{ building.effect_youthscouting }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_tickets != 0 %}+{{ building.effect_tickets }} %{% else %}-{% endif %}</td>
				<td>{% if building.effect_fanpopularity != 0 %}+{{ building.effect_fanpopularity }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_injury != 0 %}-{{ building.effect_injury }}{% else %}-{% endif %}</td>
				<td>{% if building.effect_merchandising != 0 %}+{{ building.effect_merchandising }} %{% else %}-{% endif %}</td>
				<td style="white-space: nowrap;">
				{% if building.requirement_met %}
					<a href="{{ env.getInternalActionUrl("order-building", "id=" ~ building.id) }}" class="btn btn-primary btn-small">{{ i18n.getMessage("stadiumenvironment_build") }}</a>
				{% else %}
					<span class="btn btn-small disabled">{{ i18n.getMessage("stadiumenvironment_build") }}</span>
				{% endif %}
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
	</div>
{% endif %}

{% endblock %}
